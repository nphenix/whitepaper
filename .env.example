# ============================================
# WhitePaper 项目环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际配置值
# Windows: copy .env.example .env
# Linux/Mac: cp .env.example .env
# ============================================

# ============================================
# 环境标识
# ============================================
ENVIRONMENT=development
TESTING=false
DEBUG=false

# ============================================
# LLM 模型配置（必需）
# ============================================
# 支持的提供商: openai_compatible, gemini, anthropic
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=your_api_base_url
LLM_API_KEY=your_api_key
LLM_MODEL_NAME=your_model_name
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# Gemini 配置（当 LLM_PROVIDER=gemini 时使用）
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# Anthropic Claude 配置（当 LLM_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL_NAME=claude-3-opus-20240229

# ============================================
# Embedding 模型配置（必需）
# ============================================
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=your_dashscope_api_key
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32

# ============================================
# Rerank 模型配置（必需）
# ============================================
RERANK_PROVIDER=dashscope
RERANK_API_KEY=your_dashscope_api_key
RERANK_MODEL_NAME=qwen3-rerank
RERANK_TOP_K=10

# ============================================
# PaddleOCR 在线服务配置
# ============================================
# 用于PDF和DOCX文档的OCR处理，可选配置
PADDLEOCR_API_URL=https://wdgdr4bdb5s3f5m0.aistudio-app.com/layout-parsing
PADDLEOCR_TOKEN=your_paddleocr_token
PADDLEOCR_TIMEOUT=60
PADDLEOCR_MAX_RETRIES=3

# ============================================
# MinerU 在线服务配置
# ============================================
# 用于DOCX文档解析，默认推荐使用
MINERU_API_KEY=your_mineru_api_key
MINERU_API_URL=https://mineru.net/api
MINERU_TIMEOUT=300
MINERU_MAX_RETRIES=3
MINERU_MAX_FILE_SIZE_MB=200
MINERU_MAX_PAGES=600

# ============================================
# 广告清洗LLM模型配置（OpenAI兼容接口）
# ============================================
# 用于T030A-LLM-AdRemover任务，智能识别并删除广告内容
AD_CLEANING_LLM_BASE_URL=your_ad_cleaning_api_base_url
AD_CLEANING_LLM_API_KEY=your_ad_cleaning_api_key
AD_CLEANING_LLM_MODEL_NAME=your_ad_cleaning_model_name
AD_CLEANING_LLM_TEMPERATURE=0.3
AD_CLEANING_LLM_MAX_TOKENS=8192
AD_CLEANING_LLM_TIMEOUT=120

# ============================================
# 图表转JSON LLM模型配置（支持GLM-4.6V流式调用）
# ============================================
# 用于T031B任务，将文档中的图表转换为结构化JSON数据
# 支持GLM-4.6V流式调用和OpenAI兼容接口
CHART_TO_JSON_LLM_PROVIDER=glm_4v
CHART_TO_JSON_LLM_BASE_URL=your_chart_to_json_api_base_url
CHART_TO_JSON_LLM_API_KEY=your_chart_to_json_api_key
CHART_TO_JSON_LLM_MODEL_NAME=glm-4.6v
CHART_TO_JSON_LLM_TEMPERATURE=0.1
CHART_TO_JSON_LLM_MAX_TOKENS=8192
CHART_TO_JSON_LLM_TIMEOUT=120
CHART_TO_JSON_LLM_SUPPORTS_VISION=true
CHART_TO_JSON_LLM_CONFIDENCE_THRESHOLD=0.7

# GLM-4.6V 特定配置
CHART_TO_JSON_LLM_ENABLE_STREAMING=true
CHART_TO_JSON_LLM_ENABLE_THINKING=true
CHART_TO_JSON_LLM_MAX_RETRIES=3
CHART_TO_JSON_LLM_RETRY_DELAY=1.0

# ============================================
# 数据库配置
# ============================================
DATABASE__SQLITE_DB_PATH=./storage/sqlite/whitepaper.db
DATABASE__SQLITE_POOL_SIZE=10
DATABASE__SQLITE_MAX_OVERFLOW=20
DATABASE__CHROMA_DB_PATH=./storage/chroma
DATABASE__CHROMA_COLLECTION_NAME=whitepaper_documents
DATABASE__NETWORKX_DATA_DIRECTORY=./storage/networkx
DATABASE__NETWORKX_DEFAULT_GRAPH_NAME=whitepaper_knowledge_graph
DATABASE__NETWORKX_GRAPH_PATH=./storage/networkx/knowledge_graph.pkl
DATABASE__NETWORKX_GRAPH_FORMAT=gml

# ============================================
# Redis 配置（Arq任务队列需要）
# ============================================
REDIS__REDIS_URL=redis://localhost:6379/0
REDIS__REDIS_HOST=localhost
REDIS__REDIS_PORT=6379
REDIS__REDIS_DB=0
REDIS__REDIS_PASSWORD=
REDIS__REDIS_MAX_CONNECTIONS=50
REDIS__REDIS_SOCKET_TIMEOUT=5
REDIS__REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================
# Arq 任务队列配置
# ============================================
ARQ__QUEUE_NAME=whitepaper_tasks
ARQ__MAX_JOBS=100
ARQ__JOB_TIMEOUT=3600

# ============================================
# API 服务配置
# ============================================
API__HOST=0.0.0.0
API__PORT=8000
API__RELOAD=false
API__WORKERS=4
API__LOG_LEVEL=info
API__CORS_ORIGINS=["http://localhost:3000"]
API__CORS_CREDENTIALS=true
API__CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
API__CORS_HEADERS=["*"]
API__SECRET_KEY=your-secret-key-here-change-in-production
API__ACCESS_TOKEN_EXPIRE_MINUTES=30
API__REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 日志配置
# ============================================
LOG__LEVEL=INFO
LOG__FILE=./data/logs/app.log
LOG__MAX_BYTES=10485760
LOG__BACKUP_COUNT=10
LOG__FORMAT=json
LOG__ENABLE_CONSOLE=true
LOG__ENABLE_FILE=true

# ============================================
# 文档处理配置
# ============================================
DOCUMENT__MAX_UPLOAD_SIZE=10485760
DOCUMENT__ALLOWED_EXTENSIONS=["pdf","docx","html","txt","md"]
DOCUMENT__UPLOAD_TEMP_DIR=./data/temp/uploads
DOCUMENT__PDF_PARSER=pdfplumber
DOCUMENT__HTML_PARSER=beautifulsoup4
DOCUMENT__DOCX_PARSER=mineru
DOCUMENT__OCR_ENABLED=true
DOCUMENT__OCR_LANG=ch
DOCUMENT__OCR_USE_GPU=false
DOCUMENT__OCR_USE_ANGLE_CLS=true
DOCUMENT__CHUNK_SIZE=1000
DOCUMENT__CHUNK_OVERLAP=200
DOCUMENT__MIN_CHUNK_SIZE=100

# ============================================
# 索引配置
# ============================================
INDEX__VECTOR_DIMENSION=1536
INDEX__VECTOR_METRIC=cosine
INDEX__VECTOR_TOP_K=10
INDEX__BM25_ENABLED=true
INDEX__BM25_K1=1.5
INDEX__BM25_B=0.75
INDEX__METADATA_ENABLED=true
INDEX__METADATA_FIELDS=["title","author","date","source"]
INDEX__KNOWLEDGE_GRAPH_ENABLED=true
INDEX__KG_EXTRACTION_MODEL=default
INDEX__KG_MAX_ENTITIES=1000
INDEX__KG_MAX_RELATIONS=5000

# ============================================
# Agent 配置
# ============================================
AGENT__MAX_ITERATIONS=50
AGENT__MAX_EXECUTION_TIME=300
AGENT__ENABLE_MEMORY=true
AGENT__ENABLE_CHECKPOINT=true
AGENT__CHECKPOINT_TYPE=sqlite
AGENT__CHECKPOINT_DB_PATH=./storage/sqlite/checkpoints.db
AGENT__CHECKPOINT_TTL=86400
AGENT__LANGMEM_ENABLED=true
AGENT__LANGMEM_STORAGE_TYPE=sqlite
AGENT__LANGMEM_DB_PATH=./storage/sqlite/memory.db
AGENT__LANGMEM_MAX_ENTRIES=10000

# ============================================
# 检索配置
# ============================================
RETRIEVAL__MODE=hybrid
RETRIEVAL__VECTOR_WEIGHT=0.6
RETRIEVAL__BM25_WEIGHT=0.3
RETRIEVAL__METADATA_WEIGHT=0.1
RETRIEVAL__TOP_K=10
RETRIEVAL__RERANK_ENABLED=true
RETRIEVAL__CACHE_ENABLED=true
RETRIEVAL__CACHE_TTL=3600
RETRIEVAL__CACHE_MAX_SIZE=1000
RETRIEVAL__CACHE_BACKEND=redis

# ============================================
# 文稿生成配置
# ============================================
DRAFT__MAX_LENGTH=5000
DRAFT__MIN_LENGTH=500
DRAFT__TEMPERATURE=0.8
DRAFT__TOP_P=0.9
DRAFT__FREQUENCY_PENALTY=0.5
DRAFT__PRESENCE_PENALTY=0.5
DRAFT__TEMPLATE_DIR=./data/templates/document_templates
DRAFT__TEMPLATE_DEFAULT=default.md

# ============================================
# 性能配置
# ============================================
PERFORMANCE__MAX_CONCURRENT_DOCUMENTS=5
PERFORMANCE__MAX_CONCURRENT_AGENTS=3
PERFORMANCE__MAX_CONCURRENT_REQUESTS=10
PERFORMANCE__DOCUMENT_PROCESSING_TIMEOUT=300
PERFORMANCE__AGENT_EXECUTION_TIMEOUT=180
PERFORMANCE__API_REQUEST_TIMEOUT=60
PERFORMANCE__CACHE_ENABLED=true
PERFORMANCE__CACHE_TTL=3600
PERFORMANCE__CACHE_MAX_SIZE=1000
PERFORMANCE__CACHE_BACKEND=redis

# ============================================
# 其他配置
# ============================================
TIMEZONE=Asia/Shanghai
ENCODING=utf-8
DATA_DIR=./data
STORAGE_DIR=./storage
LOG_DIR=./data/logs
TEMP_FILE_CLEANUP_ENABLED=true
TEMP_FILE_MAX_AGE=3600
PATH_SEPARATOR=/
